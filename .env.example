# Signup webhook configuration
# Local test webhook for n8n
SIGNUP_N8N_TEST_WEBHOOK_URL=https://n8n.example.nl/webhook-test/signup

# Production webhook for n8n
SIGNUP_N8N_WEBHOOK_URL=https://n8n.example.nl/webhook/signup

# Optional shared secret passed to the webhook as x-signup-secret
SIGNUP_WEBHOOK_SECRET=
